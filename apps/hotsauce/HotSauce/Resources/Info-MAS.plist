<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store 빌드 전용 Info.plist.

  ⚠️ Info.plist(직접 배포용)와 쌍둥이다. 한쪽만 고치면 두 빌드가 어긋난다.
     번들 정보(버전·아이콘·로컬라이제이션 등)를 바꿀 땐 반드시 양쪽 다 고칠 것.

  직접 배포용과의 차이:
    빠짐  — SUPublicEDKey / SUFeedURL / SUEnableAutomaticChecks /
            SUAutomaticallyUpdate / SUScheduledCheckInterval
            (앱스토어 앱은 자체 업데이트가 금지. 업데이트는 App Store 담당)
    추가  — LSApplicationCategoryType     (없으면 App Store Connect 업로드 거부)
            ITSAppUsesNonExemptEncryption (업로드마다 뜨는 암호화 설문 스킵)
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>HotSauce</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
	</array>
	<key>CFBundleName</key>
	<string>HotSauce</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 TEAM jAm. All rights reserved.</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
