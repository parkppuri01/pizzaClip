---
/**
 * 핫소스 홈 — lang 으로 한/영 공용. 마크업·스타일 동일, 텍스트만 사전(hotsauce.ts)에서.
 * 시안: apps/hotsauce/web/hotsauce_page.png
 * 섹션: 크림 히어로(틸 포스터) → 슬레이트블루 설명 카드 → 빨강 스티커 섹션 → 샌드 CTA.
 * 다운로드는 HOTSAUCE_RELEASED 가 true 일 때만 활성(그 전엔 '곧 출시').
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { HOTSAUCE_DOWNLOAD_URL, HOTSAUCE_RELEASED } from "../../consts.ts";
import { type Lang, ROUTES } from "../../i18n/ui.ts";
import { hotsauce } from "../../i18n/hotsauce.ts";

interface Props { lang?: Lang; }
const { lang = "ko" } = Astro.props;
const c = hotsauce[lang];
---
<BaseLayout
  site="hotsauce"
  lang={lang}
  koPath={ROUTES.hotsauce}
  description={c.metaDescription}
  featureList={c.featureList}
  softwareVersion="1.2.0"
>
  <!-- ===== 히어로 (크림) — 틸 심전도-병 포스터 ===== -->
  <section class="hero band">
    <div class="container hero__inner">
      <div class="hero__copy" data-reveal>
        <h1>{c.heroH1a}<br />{c.heroH1b}</h1>
        <p class="hero__lead">{c.heroLead}</p>
        <div class="hero__cta">
          {HOTSAUCE_RELEASED ? (
            <a class="pill pill--go" href={HOTSAUCE_DOWNLOAD_URL}>{c.ctaDownload}</a>
          ) : (
            <span class="pill pill--go pill--soon" aria-disabled="true">{c.ctaSoon}</span>
          )}
        </div>
      </div>
      <figure class="hero__art" data-reveal>
        <img src="/img/hotsauce/hero-poster.jpg" width="900" height="1200"
             alt={c.heroImgAlt} fetchpriority="high" />
      </figure>
    </div>
  </section>

  <!-- ===== 설명 (슬레이트블루 위 크림 카드) ===== -->
  <section class="band band--slate">
    <div class="bandwrap">
      <div class="panel explain" data-reveal>
        <p class="explain__lead">{c.explainLead}</p>
        <p>{c.explainBody1}</p>
        <p>{c.explainBody2}</p>
      </div>
    </div>
  </section>

  <!-- ===== 스티커 섹션 (빨강) — 맥북 액자 + 흩뿌린 스티커 ===== -->
  <section class="band band--red">
    <div class="bandwrap stickers">
      <img class="sticker s-wordmark hide-sm" src="/img/hotsauce/sticker-wordmark.png" alt="" aria-hidden="true" loading="lazy" />
      <img class="sticker s-spray hide-sm" src="/img/hotsauce/sticker-spray.png" alt="" aria-hidden="true" loading="lazy" />
      <figure class="laptop" data-reveal>
        <img src="/img/hotsauce/laptop-stickers.jpg" width="1200" height="1198"
             alt={c.laptopAlt} loading="lazy" />
      </figure>
      <img class="sticker s-bottle hide-sm" src="/img/hotsauce/sticker-bottle.png" alt="" aria-hidden="true" loading="lazy" />
    </div>
  </section>

  <!-- ===== 다운로드 CTA (샌드) ===== -->
  <section class="band band--sand" id="download">
    <div class="bandwrap">
      <div class="panel cta" data-reveal>
        <div class="cta__inner">
          <h2>{c.ctaH2}</h2>
          <p class="cta__lead">{c.ctaLead}</p>
          <div class="cta__btns">
            {HOTSAUCE_RELEASED ? (
              <a class="pill pill--go pill--lg" href={HOTSAUCE_DOWNLOAD_URL}>{c.ctaDownload}</a>
            ) : (
              <span class="pill pill--go pill--lg pill--soon" aria-disabled="true">{c.ctaSoon}</span>
            )}
          </div>
          <p class="cta__note">{c.ctaNote}</p>
        </div>
      </div>
      <img class="sticker s-person" src="/img/hotsauce/sticker-person.png" alt="" aria-hidden="true" loading="lazy" />
    </div>
  </section>
</BaseLayout>

<style>
  .band { overflow-x: clip; padding-block: clamp(4rem, 8vw, 7rem); position: relative; }
  .band--slate { background: var(--hs-slate); }
  .band--red   { background: var(--hs-red); padding-block: clamp(5rem, 10vw, 8rem); }
  .band--sand  { background: var(--hs-sand); padding-block: clamp(5rem, 9vw, 7.5rem); }

  .bandwrap { position: relative; max-width: 880px; margin-inline: auto; padding-inline: var(--gutter); }
  /* 설명·CTA 박스 폭 = 히어로(인트로) 콘텐츠 폭과 동일하게 맞춤(--maxw) */
  .band--slate .bandwrap,
  .band--sand .bandwrap { max-width: var(--maxw); }

  /* ── 히어로 (크림) ── */
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem); background: var(--color-bg); }
  .hero__inner { display: flex; align-items: center; gap: clamp(2rem, 6vw, 4rem); flex-wrap: wrap; }
  .hero__copy { flex: 1 1 340px; }
  .hero h1 { font-size: clamp(1.7rem, 4.5vw, 2.7rem); color: var(--color-ink); line-height: 1.2; }
  .hero__lead { font-size: 1.1rem; margin-top: 1.25rem; color: var(--color-text); max-width: 46ch; }
  .hero__cta { display: flex; gap: 0.75rem; margin-top: 2rem; flex-wrap: wrap; }
  .hero__art { flex: 0 0 auto; margin-inline: auto; width: min(340px, 78vw); }
  .hero__art img { width: 100%; height: auto; border-radius: 0;
                   box-shadow: 0 16px 36px rgba(16, 33, 56, 0.20); }

  /* ── 설명 카드 (슬레이트블루 위 크림/화이트 박스) ── */
  .panel { background: var(--color-surface); border: 3px solid #007B76; border-radius: 0;
           padding: clamp(1.75rem, 4vw, 2.75rem); box-shadow: 6px 8px 0 0 var(--hs-ink);
           width: 100%; max-width: none; }
  .explain__lead { font-size: clamp(1.15rem, 2.6vw, 1.45rem); font-weight: 800;
                   color: var(--color-ink); line-height: 1.4; }
  .explain p:not(.explain__lead) { margin-top: 1.1rem; font-size: 1.05rem;
                                   line-height: 1.7; color: var(--color-text); }

  /* ── 빨강 스티커 섹션: 맥북 액자 중앙 + 절대배치 스티커 ── */
  .stickers { display: flex; justify-content: center; }
  .laptop { width: min(430px, 88%); margin-inline: auto; }
  .laptop img { width: 100%; height: auto; border-radius: 0px;
                box-shadow: 0 18px 44px rgba(0, 0, 0, 0.10); transform: rotate(5deg);}
  .sticker { position: absolute; pointer-events: none; user-select: none; z-index: 3;
             filter: drop-shadow(2px 4px 6px rgba(0, 0, 0, 0.22)); }
  .s-wordmark { width: clamp(220px, 34vw, 420px); left: 0%;  top: -37%;  transform: rotate(-20deg); }
  .s-spray    { width: clamp(180px, 28vw, 320px); right: -10%; top: -50%; transform: rotate(10deg); }
  .s-bottle   { width: clamp(180px, 25vw, 310px); left: -20%;  bottom: -10%; transform: rotate(-16deg); }

  /* ── 다운로드 CTA (샌드) ── */
  .cta { text-align: center; }
  .cta__inner { display: flex; flex-direction: column; align-items: center; }
  .cta h2 { font-size: var(--fs-h2); color: var(--color-ink); }
  .cta__lead { max-width: 44ch; margin-top: 1rem; font-size: 1.08rem;
               line-height: 1.6; color: var(--color-text); }
  .cta__btns { display: flex; gap: 0.75rem; margin-top: 1.6rem; justify-content: center; flex-wrap: wrap; }
  .cta__note { margin-top: 1rem; font-size: var(--fs-small); opacity: 0.72; color: var(--color-ink); }
  /* person 스티커는 정사각형에 가까워 세로가 길다 → bandwrap % 대신 자기 높이 기준(translateY)으로
     카드 상단 위에 얹혀 제목을 안 가림(실제로는 위쪽 빨강 섹션에 걸침). 반응형에도 안정적. */
  .s-person { width: clamp(190px, 30vw, 380px); right: -4%; top: 40%; transform: translateY(-98%) rotate(6deg); z-index: 4; }

  /* ── 알약 버튼 (핫소스 틸) ── */
  .pill {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-en); font-weight: 700; letter-spacing: 0.02em;
    font-size: 1rem; padding: 0.6em 1.6em;
    border-radius: var(--radius-pill); border: 2px solid transparent;
    white-space: nowrap; appearance: none; -webkit-appearance: none; text-decoration: none;
    transition: transform 0.12s ease, filter 0.12s ease;
  }
  .pill--lg { font-size: 1.05rem; padding: 0.8em 2.1em; }
  .pill--go { background: #368599; color: var(--color-bg); border-color: #368599; }
  .pill--go:hover { transform: translateY(-1px); filter: brightness(1.07); }
  /* 릴리스 전: '곧 출시' 비활성 */
  .pill--soon { opacity: 0.62; cursor: default; pointer-events: none; }

  @media (max-width: 760px) {
    .hero__copy { text-align: center; }
    .hero__lead { margin-inline: auto; }
    .hero__cta { justify-content: center; }
    .hide-sm { display: none !important; }
    .laptop { width: 100%; }
    .s-person { width: clamp(150px, 46vw, 210px); right: -2%; top: 0; transform: translateY(-95%) rotate(6deg); }
  }
</style>
