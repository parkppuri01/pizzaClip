---
/**
 * 인트로 — 피자클립 / 피클 선택 화면. lang 으로 한/영 공용.
 * 가이드: web/site-renewal/사이트인트로.png
 * 슬레이트블루 배경 + 둥근 크림 네비(JAM+소셜) + 헤드라인 + 두 앱 선택 카드.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { type Lang, href, ROUTES } from "../../i18n/ui.ts";
import { intro } from "../../i18n/intro.ts";

interface Props { lang?: Lang; }
const { lang = "ko" } = Astro.props;
const c = intro[lang];

const apps = [
  { href: href(lang, "pizza"), img: "/img/intro/card-pizza.png", caption: c.pizzaCaption, aria: c.pizzaAria, alt: c.pizzaIconAlt },
  { href: href(lang, "pickle"), img: "/img/intro/card-pickle.png", caption: c.pickleCaption, aria: c.pickleAria, alt: c.pickleIconAlt },
];
---
<BaseLayout site="intro" bodyClass="intro-body" lang={lang} koPath={ROUTES.intro}>
  <section class="intro">
    <div class="intro__hero">
      <h1 class="intro__title">
        <span class="cream">{c.titleLine1}</span><br />
        <span class="cream">{c.titleLine2a}</span> <span class="dark">{c.titleLine2b}</span>
      </h1>
      <p class="intro__sub">{c.subtitle}</p>

      <ul class="intro__cards">
        {apps.map((app) => (
          <li>
            <a class="appcard" href={app.href} aria-label={app.aria}>
              <span class="appcard__art">
                <img src={app.img} width="900" height="900" alt={app.alt} />
              </span>
              <span class="appcard__cap">{app.caption}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    min-height: calc(100svh - 90px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 6vw, 4.5rem) var(--gutter) clamp(3rem, 7vw, 5rem);
  }
  .intro__hero { width: 100%; max-width: 980px; text-align: center; }

  .intro__title {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(2rem, 7vw, 4.4rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--intro-cream);
  }
  .intro__title .cream { color: var(--intro-cream); }
  .intro__title .dark  { color: var(--intro-dark); }

  .intro__sub {
    margin-top: clamp(1.1rem, 3vw, 1.8rem);
    font-size: clamp(0.9rem, 2.2vw, 1.15rem);
    letter-spacing: 0.01em;
    color: var(--intro-cream);
    opacity: 0.92;
  }

  .intro__cards {
    margin-top: clamp(2.5rem, 7vw, 4.5rem);
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 6vw, 4.5rem);
    flex-wrap: wrap;
  }
  .appcard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.9rem, 2.5vw, 1.4rem);
    width: clamp(150px, 38vw, 230px);
  }
  .appcard__art {
    display: block;
    width: 100%;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 16px 34px rgba(16, 33, 56, 0.28);
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease;
  }
  .appcard__art img { width: 100%; height: auto; display: block; }
  .appcard__cap {
    font-weight: 600;
    font-size: clamp(0.9rem, 2.3vw, 1.1rem);
    color: var(--intro-cream);
    transition: opacity 0.2s ease;
  }
  .appcard:hover .appcard__art {
    transform: translateY(-8px) scale(1.03);
    box-shadow: 0 24px 44px rgba(16, 33, 56, 0.36);
  }
  .appcard:focus-visible { outline: none; }
  .appcard:focus-visible .appcard__art { outline: 3px solid var(--intro-cream); outline-offset: 4px; }
</style>
