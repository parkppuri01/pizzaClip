---
/**
 * 피클 홈 — lang 으로 한/영 공용. 마크업·스타일 동일, 텍스트만 사전(pickle.ts)에서.
 * 가이드: web/site-renewal/피클guide.png (2026-06-11 개정 — '하는 일' 기능 3개를 띠 패널에 분산)
 * 띠: 크림(히어로, PIC/KLE 포스터) → 올리브(기능1) → 블루(기능2) → 샌드(기능3+맥북피클·스케이트뱃지)
 *     → 올리브(피클이 하는 일 — 이모지 4개) → 크림(I'm a PICkle·스냅툴 + 단축키) → 그레이(CTA).
 * 1.0.0 정식 출시 — 다운로드는 PICKLE_DOWNLOAD_URL(로컬 호스팅 DMG) 직링크.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoModal from "../VideoModal.astro";
import { PICKLE_DOWNLOAD_URL } from "../../consts.ts";
import { type Lang, ROUTES } from "../../i18n/ui.ts";
import { pickle } from "../../i18n/pickle.ts";

interface Props { lang?: Lang; }
const { lang = "ko" } = Astro.props;
const c = pickle[lang];
---
<BaseLayout
  site="pickle"
  lang={lang}
  koPath={ROUTES.pickle}
  description={c.metaDescription}
  featureList={c.featureList}
  softwareVersion="1.4.0"
>
  <!-- ===== 히어로 (크림) — PIC/KLE 그린 포스터 ===== -->
  <section class="hero band">
    <div class="container hero__inner">
      <div class="hero__copy" data-reveal>
        <h1>{c.heroH1a} <br />{c.heroH1b}</h1>
        <p class="hero__lead">{c.heroLead}</p>
        <div class="hero__cta">
          <a class="pill pill--go" href={PICKLE_DOWNLOAD_URL}>{c.ctaDownload}</a>
          <button class="pill pill--tut" type="button" data-open-video>{c.ctaTutorial}</button>
        </div>
      </div>
      <figure class="hero__art" data-reveal>
        <img src="/img/pickle/hero-poster.jpg" width="900" height="1200"
             alt={c.heroImgAlt} fetchpriority="high" />
      </figure>
    </div>
  </section>

  <!-- ===== 기능 1 · 자동 저장 (올리브) ===== -->
  <section class="band band--olive" id="pk-start">
    <div class="bandwrap">
      <div class="panel featpanel" data-reveal>
        <h2>{c.features[0].title}</h2>
        <p>{c.features[0].desc}</p>
      </div>
    </div>
  </section>

  <!-- ===== 기능 2 · 간편 편집 (블루) — 올리브/블루 경계에 스티커 3종 ===== -->
  <section class="band band--blue">
    <div class="bandwrap">
      <img class="sticker s-easy" src="/img/pickle/sticker-easy.png" alt="" aria-hidden="true" loading="lazy" />
      <img class="sticker s-snap hide-sm" src="/img/pickle/snap-oval.png" alt="" aria-hidden="true" loading="lazy" />
      <img class="sticker s-jar hide-sm" src="/img/pickle/jar.png" alt="" aria-hidden="true" loading="lazy" />
      <div class="panel featpanel" data-reveal>
        <h2>{c.features[1].title}</h2>
        <p>{c.features[1].desc}</p>
      </div>
    </div>
  </section>

  <!-- ===== 기능 3 · 메뉴바 보관함 (샌드) — 블루/샌드 경계 스티커 2종 + 아래 맥북피클·스케이트뱃지 ===== -->
  <section class="band band--sand">
    <div class="bandwrap">
      <img class="sticker s-fresh" src="/img/pickle/card-fresh.png" alt="" aria-hidden="true" loading="lazy" />
      <img class="sticker s-sign hide-sm" src="/img/pickle/sign-char.png" alt="" aria-hidden="true" loading="lazy" />
      <div class="panel featpanel" data-reveal>
        <h2>{c.features[2].title}</h2>
        <p>{c.features[2].desc}</p>
      </div>
      <div class="stickerline stickerline--sand">
        <img class="inline-sticker s-laptop2" src="/img/pickle/mascot-laptop.png" alt="" aria-hidden="true" loading="lazy" />
        <img class="inline-sticker s-skate hide-sm" src="/img/pickle/badge-skate.png" alt="" aria-hidden="true" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ===== 피클이 하는 일 (올리브) — 이모지 4개 요약 ===== -->
  <section class="band band--olive" id="pk-features">
    <div class="bandwrap">
      <div class="panel features" data-reveal>
        <h2 class="features__title">{c.pointsTitle}</h2>
        <ul class="minifeats">
          {c.points.map((f) => (
            <li>
              <h3>{f.icon} {f.title}</h3>
              <p>{f.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== 단축키 (크림) — 위에 I'm a PICkle · 스냅툴 스티커 줄 ===== -->
  <section class="band band--cream" id="pk-shortcuts">
    <div class="bandwrap">
      <div class="stickerline stickerline--brand">
        <img class="inline-sticker s-imapickle" src="/img/pickle/sticker-imapickle.png" alt="" aria-hidden="true" loading="lazy" />
        <img class="inline-sticker s-snap2 hide-sm" src="/img/pickle/snap-oval.png" alt="" aria-hidden="true" loading="lazy" />
      </div>
      <div class="panel shortcuts" data-reveal>
        <h2>{c.shortcutsTitle}</h2>
        <p class="panel__sub">{c.shortcutsSub}</p>
        <dl class="kbd-list">
          {c.shortcuts.map((s) => (
            <div class="kbd-row">
              <dt><kbd>{s.keys}</kbd></dt>
              <dd>{s.desc}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ===== 다운로드 CTA (그레이) ===== -->
  <section class="band band--gray" id="download">
    <div class="bandwrap">
      <div class="panel cta" data-reveal>
        <div class="cta__inner">
          <h2>{c.ctaH2}</h2>
          <p class="cta__lead">{c.ctaLead}</p>
          <div class="cta__btns">
            <a class="pill pill--go pill--lg" href={PICKLE_DOWNLOAD_URL}>{c.ctaDownload}</a>
          </div>
          <p class="cta__note">{c.ctaNote}</p>
        </div>
      </div>
      <img class="sticker s-person" src="/img/pickle/sticker-person.png" alt="" aria-hidden="true" loading="lazy" />
    </div>
  </section>

  <!-- 튜토리얼 영상 팝업 (히어로 ▶ 튜토리얼 버튼이 염) -->
  <VideoModal videoId="HJ1hLgfnWfQ" title={c.videoTitle} lang={lang} />
</BaseLayout>

<style>
  .band { overflow-x: clip; padding-block: clamp(5rem, 9vw, 8rem); position: relative; }
  .band--olive { background: var(--pk-olive); }
  .band--blue  { background: var(--pk-blue); }
  .band--sand  { background: var(--pk-sand); }
  .band--gray  { background: var(--pk-gray); }
  .band--cream { background: var(--color-bg); }

  /* 자동저장(올리브)↔빠른접근(블루) 박스 사이를 넓혀 스티커가 놀 공간 확보(가이드 기준).
     올리브쪽 패딩을 크게 줘 경계를 내려 스티커가 올리브 배경 위에 놓이게.
     (1번: Easy/스냅툴/병 스티커 영역이 좁아 더 벌림) */
  #pk-start { padding-bottom: clamp(13rem, 18vw, 16rem); }
  /* --pk-gap-pt 를 블루 패딩과 스티커 위치 calc 에 함께 써서, 스티커가 항상 경계선 기준 일정 높이에 놓이게(폭 무관 안정). */
  .band--blue { --pk-gap-pt: clamp(5rem, 9vw, 7.5rem); padding-top: var(--pk-gap-pt); }

  /* (2번: 샌드 박스3 ↔ 올리브 '피클이 하는 일' 사이가 너무 넓어 양쪽 패딩을 줄임) */
  .band--sand { padding-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  #pk-features { padding-top: clamp(3rem, 5vw, 4.5rem); }
  /* (3번: 올리브 '피클이 하는 일' ↔ 크림 단축키 사이를 약간 더 벌림) */
  #pk-shortcuts { padding-top: clamp(8.5rem, 12vw, 11rem); }

  /* 위치 기준 = 카드 폭의 래퍼 */
  .bandwrap { position: relative; max-width: 880px; margin-inline: auto; padding-inline: var(--gutter); }

  /* ── 콘텐츠 패널(피클: 직각 사각형 + 차콜 오프셋 그림자) ── */
  .bandwrap .panel { width: 100%; max-width: none; margin: 0; border-radius: 2px; }
  .panel h2 { font-size: var(--fs-h2); color: var(--color-ink); }
  .panel__sub { margin-top: 1rem; font-size: 1.15rem; color: var(--pk-olive-ink); font-weight: 700; }
  .panel p { margin-top: 0.8rem; font-size: 1.08rem; color: var(--color-text); }

  /* ── 기능 패널(가이드 빨간 박스): 볼드 헤드라인 + 본문 ──
     가이드처럼 박스를 길쭉하게. min-height 로 키우고 내용은 세로 가운데 정렬(셋 다 동일). */
  .featpanel { min-height: clamp(240px, 23vw, 300px); display: flex; flex-direction: column; justify-content: center; }
  .featpanel h2 { font-size: 1.22rem; line-height: 1.45; color: var(--color-ink); }
  .featpanel p { margin-top: 0.85rem; font-size: 1.03rem; line-height: 1.66; color: var(--color-text); }
  /* 샌드 패널은 스케이트 뱃지보다 위에(뱃지가 카드 밑으로 살짝 들어감) */
  .band--sand .panel { position: relative; z-index: 2; }

  /* ── 피클이 하는 일: 이모지 + 헤드라인 + 본문 ── */
  .features__title { margin-bottom: 1.25rem; }
  .minifeats { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.05rem; }
  .minifeats h3 { font-size: 1.05rem; line-height: 1.4; color: var(--color-ink); }
  .minifeats p { margin-top: 0.3rem; font-size: 0.98rem; line-height: 1.6; color: var(--color-text); }

  /* ── 히어로 ── */
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem); }
  .hero__inner { display: flex; align-items: center; gap: clamp(2rem, 6vw, 4rem); flex-wrap: wrap; }
  .hero__copy { flex: 1 1 340px; }
  .hero h1 { font-size: clamp(1.6rem, 4.3vw, 2.6rem); color: var(--color-ink); line-height: 1.22; }
  .hero__lead { font-size: 1.1rem; margin-top: 1.25rem; color: var(--color-text); max-width: 46ch; }
  .hero__cta { display: flex; gap: 0.75rem; margin-top: 2rem; flex-wrap: wrap; }
  .hero__art { flex: 0 0 auto; margin-inline: auto; width: min(320px, 74vw); }
  .hero__art img { width: 100%; height: auto; border-radius: 8px;
                   box-shadow: 0 14px 34px rgba(16, 33, 56, 0.18); }

  /* ── 단축키 표(how-to 단축키와 동일 톤) ── */
  .kbd-list { margin-top: 1.4rem; display: grid; gap: 0.6rem; }
  .kbd-row { display: grid; grid-template-columns: minmax(120px, 200px) 1fr; gap: 1rem; align-items: baseline; }
  .kbd-row dd { color: var(--color-ink); }
  kbd {
    font-family: var(--font-en);
    background: var(--color-ink); color: var(--color-bg);
    padding: 0.25em 0.6em; border-radius: 6px; font-size: 0.95rem;
    white-space: nowrap; display: inline-block;
  }

  /* ── 다운로드 CTA ── */
  .cta { text-align: center; }
  .cta__inner { display: flex; flex-direction: column; align-items: center; }
  .cta__lead { max-width: 48ch; }
  .cta__btns { display: flex; gap: 0.75rem; margin-top: 1.6rem; flex-wrap: wrap; justify-content: center; }
  .cta__note { margin-top: 1rem; font-size: var(--fs-small); opacity: 0.7; }

  /* ── 피클 알약 버튼 ── */
  .pill {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-en); font-weight: 700; letter-spacing: 0.02em;
    font-size: 1rem; padding: 0.6em 1.5em;
    border-radius: var(--radius-pill); border: 2px solid transparent;
    white-space: nowrap; appearance: none; -webkit-appearance: none;
    transition: transform 0.12s ease, background 0.12s ease, color 0.12s ease;
  }
  .pill--lg { font-size: 1.05rem; padding: 0.8em 2em; }
  /* 다운로드(채운 올리브) */
  .pill--go { background: var(--pk-olive-ink); color: var(--color-bg); border-color: var(--pk-olive-ink); }
  .pill--go:hover { background: var(--pk-green); border-color: var(--pk-green); transform: translateY(-1px); }
  /* 튜토리얼(외곽선 올리브) */
  .pill--tut { background: transparent; color: var(--pk-olive-ink); border-color: var(--pk-olive-ink); cursor: pointer; }
  .pill--tut:hover { background: var(--pk-olive-ink); color: var(--color-bg); transform: translateY(-1px); }

  /* ── 절대배치 스티커: 카드 사이 경계에 얹힘(위로 삐짐), 카드 폭 기준 좌·중·우 ── */
  .sticker { position: absolute; pointer-events: none; user-select: none; z-index: 3;
             filter: drop-shadow(2px 4px 5px rgba(0,0,0,0.18)); width: var(--sw, 160px); }
  /* 올리브/블루 경계: Easy(좌) · SNAP TOOL(중) · 병(우) */
  .s-easy { --sw: clamp(150px, 19vw, 250px); left: 5%; top: calc(-1 * var(--pk-gap-pt) - 9rem); transform: rotate(-7deg); }
  .s-snap { --sw: clamp(200px, 17vw, 225px); left: 50%; top: calc(-1 * var(--pk-gap-pt) - 6rem); transform: translateX(-50%) rotate(2deg); }
  .s-jar  { --sw: clamp(78px, 10vw, 125px); right: 11%; top: calc(-1 * var(--pk-gap-pt) - 10rem); transform: rotate(-15deg); }
  /* 블루/샌드 경계: Screenshot 카드(좌) · 안내판 피클(우) */
  .s-fresh { --sw: clamp(250px, 22vw, 255px); left: 10%; top: -35%; transform: rotate(4deg); }
  .s-sign  { --sw: clamp(170px, 18vw, 200px); right: 10%; top: -30%; transform: rotate(2deg); }
  /* 그레이: "I'm a PICkle person" — 카드 우상단 모서리 */
  .s-person { --sw: clamp(115px, 16vw, 195px); right: -2%; top: -18%; transform: rotate(6deg); }

  /* ── 흐름배치 스티커 줄(모바일 안전) ── */
  .stickerline { display: flex; align-items: flex-start; }
  .inline-sticker { height: auto; pointer-events: none; user-select: none;
                    filter: drop-shadow(2px 4px 5px rgba(0,0,0,0.18)); }
  /* 샌드: 맥북 피클(좌) + 스케이트 뱃지(우, 카드 밑으로 살짝) — 패널 아래 */
  .stickerline--sand { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .s-laptop2 { width: clamp(180px, 26vw, 300px); margin-left: -2%; }
  .s-skate { width: clamp(150px, 21vw, 235px); margin-left: auto; margin-right: -10%;
             margin-top: -4rem; position: relative; z-index: 4; }
  /* 크림(단축키): I'm a PICkle(좌) + 스냅툴(우) — 올리브 스페이서 경계에 걸침(위로 끌어올림) */
  .stickerline--brand { margin-top: calc(-1 * clamp(5rem, 9vw, 8rem) - 9rem);
                        margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .s-imapickle { width: clamp(210px, 34vw, 335px); margin-left: 2%; transform: rotate(-4deg); }
  .s-snap2 { width: clamp(200px, 30vw, 300px); margin-left: auto; margin-right: -2%;
             margin-top: 6rem; transform: rotate(3deg); }

  @media (max-width: 760px) {
    .hero__copy { text-align: center; }
    .hero__lead { margin-inline: auto; }
    .hero__cta { justify-content: center; }
    .hide-sm { display: none !important; }
    /* 모바일은 s-easy 1개만 노출 → 올리브 간격 적당히 줄이고 가운데 배치 */
    #pk-start { padding-bottom: clamp(6rem, 15vw, 8.5rem); }
    .s-easy { --sw: 116px; left: 0; top: calc(-1 * var(--pk-gap-pt) - 2.5rem); }
    .s-fresh { --sw: 116px; left: 0; top: -23%; }
    .s-person { --sw: 92px; right: -1%; top: -15%; }
    .s-laptop2 { width: 132px; margin-left: 0; }
    .stickerline--brand { margin-top: -9.5rem; margin-bottom: 1.5rem; }
    .s-imapickle { width: 158px; }
    .kbd-row { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
