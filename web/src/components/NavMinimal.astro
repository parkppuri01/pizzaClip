---
/**
 * NavMinimal — 로고 + 소셜 아이콘만 있는 미니멀 네비.
 *  theme="intro"  : 슬레이트 배경 위에 둥근 크림 알약. 로고 = 원형 JAM.
 *  theme="pickle" : 크림 배경 위 상단 바 + 얇은 올리브 밑줄. 로고 = "PICKle" 텍스트.
 */
import SocialIcons from "./SocialIcons.astro";
import { GITHUB_URL, PICKLE_GITHUB_URL } from "../consts.ts";
interface Props {
  theme?: "intro" | "pickle";
  logoHref?: string;
}
const { theme = "intro", logoHref = "/" } = Astro.props;
const github = theme === "pickle" ? PICKLE_GITHUB_URL : GITHUB_URL;
---
<header class:list={["navm", `navm--${theme}`]}>
  <div class="navm__bar">
    {theme === "intro" ? (
      <a class="navm__logo navm__logo--jam" href={logoHref} aria-label="Team JAM 홈">
        <img src="/img/jam-logo.png" width="40" height="40" alt="Team JAM" />
      </a>
    ) : (
      <a class="navm__logo navm__logo--text" href={logoHref}>PICKle</a>
    )}
    <SocialIcons github={github} />
  </div>
</header>

<style>
  .navm { position: relative; z-index: 40; }

  /* ── 인트로: 떠 있는 크림 알약 ── */
  .navm--intro { padding: clamp(0.75rem, 2vw, 1.25rem) clamp(0.75rem, 2.5vw, 1.75rem) 0; }
  .navm--intro .navm__bar {
    max-width: 1180px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--intro-nav);
    border-radius: var(--radius-pill);
    padding: clamp(0.5rem, 1.4vw, 0.85rem) clamp(1rem, 2.4vw, 1.6rem);
    box-shadow: 0 6px 22px rgba(16, 33, 56, 0.14);
  }
  .navm__logo--jam img {
    width: clamp(34px, 8vw, 42px);
    height: auto;
    border-radius: 50%;
  }

  /* ── 피클: 크림 상단 바 + 올리브 밑줄 ── */
  .navm--pickle {
    background: var(--color-bg);
    border-bottom: 2px solid var(--pk-olive-ink);
    position: sticky;
    top: 0;
  }
  .navm--pickle .navm__bar {
    max-width: var(--maxw);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
    padding-inline: var(--gutter);
  }
  .navm__logo--text {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: clamp(1.2rem, 4vw, 1.7rem);
    letter-spacing: 0.02em;
    color: var(--pk-olive-ink);
  }
  .navm__logo--text:hover { opacity: 0.8; }
</style>
