---
/**
 * SliceDivider — 섹션 사이 피자 디바이더.
 * count(1~4) 만큼 피자가 한 조각씩 차오르는 그림으로 표시한다
 * (design.md §3-3 모티프 — 앱 메뉴바 아이콘과 같은 언어).
 * 장식용이라 aria-hidden.
 */
interface Props {
  /** 피자 조각 단계 (1~4) */
  count?: number;
}
const { count = 1 } = Astro.props;
const step = Math.min(4, Math.max(1, count));
const src = `/img/slice-${step}.png`;
---
<div class="slice" aria-hidden="true">
  <img src={src} alt="" loading="lazy" decoding="async" />
</div>

<style>
  .slice {
    text-align: center;
    margin-block: clamp(1.25rem, 4vw, 2.25rem);
    user-select: none;
  }
  .slice img {
    display: inline-block;
    height: clamp(48px, 7vw, 64px);
    width: auto;
  }
</style>
