---
/** Footer — 하단 정보 */
import { GITHUB_URL } from "../consts.ts";

// 푸터 메뉴는 홈 · 사용법 · 깃허브만 (INFO 는 상단 네비에만 노출)
const footerLinks = [
  { href: "/", ko: "홈" },
  { href: "/how-to", ko: "사용법" },
];
---
<footer class="footer">
  <div class="container footer__inner">
    <span class="footer__brand">🍕 PIZZA CLIP</span>
    <nav aria-label="하단 메뉴">
      <ul class="footer__links">
        {footerLinks.map((l) => (<li><a href={l.href}>{l.ko}</a></li>))}
        <li><a href={GITHUB_URL} target="_blank" rel="noopener">깃허브</a></li>
      </ul>
    </nav>
    <small class="footer__copy">© 2026 pizzaClip · Team JAM</small>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-bg);
    padding-block: 2.5rem;
    margin-top: var(--section-gap);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }
  .footer__brand { font-family: var(--font-en); font-weight: 700; font-size: 1.1rem; }
  .footer__links { display: flex; gap: 1.25rem; flex-wrap: wrap; font-size: var(--fs-small); }
  .footer__links a:hover { color: var(--color-menu); }
  .footer__copy { margin-left: auto; opacity: 0.7; }
  @media (max-width: 640px) {
    .footer__copy { margin-left: 0; width: 100%; }
  }
</style>
