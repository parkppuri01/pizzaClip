---
/** Footer — 하단 정보 */
import { NAV_LINKS, GITHUB_URL } from "../consts.ts";
const year = new Date().getFullYear(); // 빌드 시점 연도 (자동 갱신)
---
<footer class="footer">
  <div class="container footer__inner">
    <span class="footer__brand">🍕 PIZZA CLIP</span>
    <nav aria-label="하단 메뉴">
      <ul class="footer__links">
        {NAV_LINKS.map((l) => (<li><a href={l.href}>{l.ko}</a></li>))}
        <li><a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </nav>
    <small class="footer__copy">© {year} pizzaClip · 개인 프로젝트</small>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-bg);
    padding-block: 2.5rem;
    margin-top: var(--section-gap);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }
  .footer__brand { font-family: var(--font-en); font-weight: 700; font-size: 1.1rem; }
  .footer__links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .footer__links a:hover { color: var(--color-menu); }
  .footer__copy { margin-left: auto; opacity: 0.7; }
  @media (max-width: 640px) {
    .footer__copy { margin-left: 0; width: 100%; }
  }
</style>
