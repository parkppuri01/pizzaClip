---
/**
 * ⚠️ DEPRECATED (2026-06-09): 더 이상 렌더되지 않음.
 *   피자 페이지도 NavMinimal(theme="pizza")로 통일되며 BaseLayout 에서 제거됨.
 *   '피자 상단바에 메뉴/Download 버튼 복구'를 원하면 이 컴포넌트를 되살리면 됨.
 *   계속 안 쓸 거면 이 파일 + consts.ts 의 NAV_LINKS 를 삭제해도 안전.
 *
 * Navbar — 상단 옐로우 메뉴바 (design.md §3-1)
 * 메뉴 글자색 교차: 홀수=네이비, 짝수=빨강. 우측 DOWNLOAD 버튼.
 */
import Button from "./Button.astro";
import { NAV_LINKS, DOWNLOAD_URL, PIZZA_HOME } from "../consts.ts";

// 현재 경로 (활성 메뉴 표시용)
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---
<header class="navbar">
  <div class="container navbar__inner">
    <a class="navbar__logo" href={PIZZA_HOME}>PIZZA&nbsp;CLIP</a>

    <nav aria-label="주요 메뉴">
      <ul class="navbar__links">
        {
          NAV_LINKS.map((link, i) => (
            <li>
              <a
                href={link.href}
                class:list={["navbar__link", { "is-active": isActive(link.href) }]}
                data-color={i % 2 === 0 ? "ink" : "point"}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button href={DOWNLOAD_URL} variant="primary" class="navbar__cta">Download</Button>
  </div>
</header>

<style>
  .navbar {
    background: var(--color-menu);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .navbar__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    min-height: 64px;
    flex-wrap: nowrap; /* 줄바꿈 금지 — 좁아지면 글자·버튼이 줄어듦 */
  }
  .navbar__logo {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: clamp(1.05rem, 3.6vw, 1.6rem);
    letter-spacing: 0.04em;
    color: var(--color-point); /* 로고 = 빨간색 */
    margin-right: auto;
    white-space: nowrap;
  }
  .navbar__links {
    display: flex;
    gap: clamp(0.6rem, 2.6vw, 2.5rem);
    align-items: center;
    flex-wrap: nowrap;
  }
  .navbar__link {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: clamp(0.85rem, 2.1vw, 1.2rem);
    letter-spacing: 0.03em;
    padding-block: 0.25rem;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
  }
  /* 다운로드 버튼 — Card/Button 컴포넌트 경계를 넘으려 :global 사용. 좁아지면 함께 축소 */
  .navbar :global(.navbar__cta) {
    white-space: nowrap;
    font-size: clamp(0.8rem, 1.9vw, 1.1rem);
    padding: 0.55em clamp(0.85em, 2.4vw, 1.6em);
  }
  /* 색 교차 (design.md: PIZZA=네이비, CLIP=빨강 …) */
  .navbar__link[data-color="ink"]   { color: var(--color-ink); }
  .navbar__link[data-color="point"] { color: var(--color-point); }
  .navbar__link[href="/how-to"]     { color: #111; } /* HOW TO = 검정 */
  .navbar__link:hover    { opacity: 0.75; }
  .navbar__link.is-active { border-bottom-color: currentColor; }

  @media (max-width: 640px) {
    .navbar__inner { padding-block: 0.6rem; }
  }
</style>
