---
/**
 * Navbar — 상단 옐로우 메뉴바 (design.md §3-1)
 * 메뉴 글자색 교차: 홀수=네이비, 짝수=빨강. 우측 DOWNLOAD 버튼.
 */
import Button from "./Button.astro";
import { NAV_LINKS, DOWNLOAD_URL } from "../consts.ts";

// 현재 경로 (활성 메뉴 표시용)
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---
<header class="navbar">
  <div class="container navbar__inner">
    <a class="navbar__logo" href="/">PIZZA&nbsp;CLIP</a>

    <nav aria-label="주요 메뉴">
      <ul class="navbar__links">
        {
          NAV_LINKS.map((link, i) => (
            <li>
              <a
                href={link.href}
                class:list={["navbar__link", { "is-active": isActive(link.href) }]}
                data-color={i % 2 === 0 ? "ink" : "point"}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button href={DOWNLOAD_URL} variant="primary" class="navbar__cta">Download</Button>
  </div>
</header>

<style>
  .navbar {
    background: var(--color-menu);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .navbar__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .navbar__logo {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    margin-right: auto;
  }
  .navbar__links {
    display: flex;
    gap: clamp(1rem, 4vw, 2.5rem);
    align-items: center;
  }
  .navbar__link {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    padding-block: 0.25rem;
    border-bottom: 3px solid transparent;
  }
  /* 색 교차 (design.md: PIZZA=네이비, CLIP=빨강 …) */
  .navbar__link[data-color="ink"]   { color: var(--color-ink); }
  .navbar__link[data-color="point"] { color: var(--color-point); }
  .navbar__link:hover    { opacity: 0.75; }
  .navbar__link.is-active { border-bottom-color: currentColor; }

  @media (max-width: 640px) {
    .navbar__inner { gap: 0.5rem 1rem; padding-block: 0.75rem; }
    .navbar__logo  { font-size: 1.2rem; width: 100%; margin-right: 0; }
    .navbar__cta   { margin-left: auto; }
  }
</style>
