---
/**
 * BaseLayout — 모든 페이지 공통 틀
 * <head> 메타 + canonical + og + 폰트, 그리고 site 별 네비/푸터.
 *
 * site:
 *   "pizza"  (기본) → 크림 NavMinimal(theme=pizza, 옐로우 #FFB703 밑줄) + 네이비 Footer (홈/how-to/info)
 *   "pickle"        → 크림 NavMinimal(theme=pickle, 올리브 밑줄) + PickleFooter
 *   "intro"         → 떠 있는 NavMinimal(theme=intro, JAM), 푸터 없음 (정보 페이지도 이 톤 사용)
 */
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import NavMinimal from "../components/NavMinimal.astro";
import PickleFooter from "../components/PickleFooter.astro";
import {
  SITE_TITLE, SITE_DESC, DOWNLOAD_URL, GITHUB_URL,
  PICKLE_TITLE, PICKLE_DESC, PICKLE_GITHUB_URL, PICKLE_DOWNLOAD_URL, PICKLE_RELEASED,
} from "../consts.ts";

interface Props {
  title?: string;
  description?: string;
  image?: string;        // og 이미지 (사이트 루트 기준 경로)
  site?: "pizza" | "pickle" | "intro";
  bodyClass?: string;    // <body> 추가 클래스 (인트로 슬레이트 배경 등)
}
const {
  title,
  site = "pizza",
  description = site === "pickle" ? PICKLE_DESC : SITE_DESC,
  image = site === "pickle" ? "/img/og-pickle.jpg"
        : site === "intro"  ? "/img/og-intro.jpg"
        : "/img/og-home.jpg",
  bodyClass = "",
} = Astro.props;

// 제품/메타 — site 별 분기
const appName  = site === "pickle" ? PICKLE_TITLE
               : site === "intro"  ? "PIZZA CLIP & PICkle"
               : SITE_TITLE;
const appDesc  = site === "pickle" ? PICKLE_DESC : SITE_DESC;
const appCat   = "UtilitiesApplication";
const ghUrl    = site === "pickle" ? PICKLE_GITHUB_URL : GITHUB_URL;
const dlUrl    = site === "pickle" ? PICKLE_DOWNLOAD_URL : DOWNLOAD_URL;
const released = site === "pickle" ? PICKLE_RELEASED : true;

const defaultTitle =
  site === "pickle" ? `${PICKLE_TITLE} — 맥 스크린샷 정리 앱`
  : site === "intro" ? `PIZZA CLIP & PICkle — Team JAM`
  : `${SITE_TITLE} — 맥 클립보드 히스토리 앱`;
const pageTitle = title ? `${title} · ${appName}` : defaultTitle;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const siteUrl = Astro.site?.toString() ?? "https://pizza-clip.com/";

// 페이지별 파비콘(탭 아이콘): 피자=🍕 / 피클=🥒 / 인트로·인포=JAM 로고
const faviconSvg = site === "pickle" ? "/favicon-pickle.svg"
                 : site === "intro"  ? "/favicon-jam.svg"
                 : "/favicon-pizza.svg";

// 구조화 데이터(JSON-LD)
const softwareApp: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: appName,
  applicationCategory: appCat,
  operatingSystem: "macOS",
  description: appDesc,
  url: canonical.toString(),
  image: ogImage.toString(),
  inLanguage: "ko",
  offers: { "@type": "Offer", price: "0", priceCurrency: "KRW" },
  author: { "@type": "Organization", name: "Team JAM", url: siteUrl },
};
if (released) softwareApp.downloadUrl = new URL(dlUrl, Astro.site).toString();

const jsonLd = [
  // 인트로(/)는 '두 앱 선택 화면'이라 특정 앱(SoftwareApplication)으로 선언하지 않는다.
  // (루트 URL=PizzaClip 앱+다운로드로 잘못 색인되는 것 방지) → WebSite/Organization 만.
  ...(site === "intro" ? [] : [softwareApp]),
  { "@context": "https://schema.org", "@type": "WebSite", name: appName, url: siteUrl, inLanguage: "ko" },
  { "@context": "https://schema.org", "@type": "Organization", name: "Team JAM", url: siteUrl, sameAs: [GITHUB_URL, PICKLE_GITHUB_URL] },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) — GA4 방문/이벤트 측정 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-30DB0P1HWL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-30DB0P1HWL');
    </script>

    <!-- 다운로드 버튼 클릭 → GA4 전환 이벤트 -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href$=".dmg"], a[href*="releases/latest/download/"]');
        if (!a || typeof gtag !== 'function') return;
        var label = (/pickle/i.test(a.href) || (a.getAttribute('href') || '').indexOf('/pickle/') === 0) ? 'pickle.dmg' : 'pizzaClip.dmg';
        gtag('event', 'download', { event_category: 'engagement', event_label: label, transport_type: 'beacon' });
      });
    </script>

    <!-- 파비콘 (페이지별: 피자🍕 / 피클🥒 / 인트로·인포 JAM) — SVG를 우선 사용, .ico는 구형 폴백 -->
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#E63946" />

    <!-- 네이버 사이트 소유확인 -->
    <meta name="naver-site-verification" content="ae2a9984e7dcb6f0b55f9f630e79ffc8ae1907b0" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={appName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 구조화 데이터 (JSON-LD) -->
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Pretendard (한글 본문) -->
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.min.css"
    />

    <!-- Alfa Slab One (PICKle 로고 전용) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&display=swap" />
  </head>
  <body class={bodyClass}>
    {site === "pizza" && <NavMinimal theme="pizza" />}
    {site === "pickle" && <NavMinimal theme="pickle" />}
    {site === "intro" && <NavMinimal theme="intro" />}

    <main id="main"><slot /></main>

    {site === "pizza" && <Footer />}
    {site === "pickle" && <PickleFooter />}

    <!-- 스크롤 등장(점진적 향상): JS 있을 때만 숨겼다가 뷰포트 진입 시 표시 -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js-reveal');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
