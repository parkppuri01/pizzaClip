---
/**
 * INFO — 릴리스노트(피자클립 + 피클) + Team JAM 소개.
 * 디자인은 인트로(/) 를 그대로 이어받음: 슬레이트 블루 배경 + 떠 있는 크림 네비(JAM) + 푸터 없음.
 * 콘텐츠(버전 기록·팀 소개)는 살리고 톤만 인트로로 맞춤.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, PICKLE_GITHUB_URL, PIZZA_HOME } from "../consts.ts";

// 피자클립 버전 히스토리 — 개발 용어 대신 일반 유저가 읽을 수 있는 말로.
const releases = [
  {
    version: "1.1.0",
    label: "팝업 잠금 · 여러 개 고정",
    notes: [
      "팝업 상단에 자물쇠 버튼이 생겼어요 — 잠그면 다른 곳을 눌러도 팝업이 닫히지 않아요.",
      "⌘P로 여러 항목을 한꺼번에 고정 — 고정한 순서대로 1, 2, 3번 자리를 차지해요.",
      "팝업 상단에 보관 개수 배지와 닫기 버튼을 더해 한눈에 보기 좋아졌어요.",
      "오른쪽 ⌘ 한/영 전환이 더 안정적으로 동작하도록 다듬었어요.",
      "업데이트 창에서 새 버전의 바뀐 점을 바로 확인할 수 있어요.",
    ],
  },
  {
    version: "1.0.0",
    label: "정식 출시 🎉",
    notes: [
      "복사한 텍스트·이미지·파일을 메뉴바에 차곡차곡 보관",
      "단축키 한 번으로 원하는 항목 바로 붙여넣기",
      "히스토리가 쌓일수록 메뉴바 피자가 한 조각씩 늘어나요",
      "Apple 인증 완료로 설치 경고 없이 깔끔하게 실행",
      "새 버전이 나오면 알아서 업데이트",
    ],
  },
  { version: "0.1.7", label: "자동 업데이트 도입",
    notes: ["앱이 스스로 최신 버전을 확인하고 받아오기 시작했어요."] },
  { version: "0.1.6", label: "Apple 인증 + 🍕 ‘피자’ 깜짝 연출",
    notes: [
      "Apple 개발자 인증을 받아 설치 시 보안 경고가 사라졌어요.",
      "‘피자’ 또는 ‘pizza’를 복사하면 화면에 피자가 팡팡 터집니다.",
    ] },
  { version: "0.1.5", label: "한/영 전환 추가",
    notes: ["오른쪽 ⌘ 키 한 번으로 한국어 ↔ 영문 전환 (켜고 끌 수 있는 옵션)."] },
  { version: "0.1.4", label: "🍕 이스터에그",
    notes: ["‘pizza’를 복사하면 피자가 튀어오르는 깜짝 애니메이션을 넣었어요."] },
  { version: "0.1.3", label: "새 앱 아이콘 · pizzaClip 으로 이름 정리",
    notes: ["앱 아이콘과 메뉴바 피자 그림을 새로 단장했어요."] },
  { version: "0.1.1", label: "첫 공개",
    notes: ["자동 복사 기록, 팝업, 핀 고정, 전체 비우기 등 기본기를 갖췄어요."] },
];

// 피클 버전 히스토리
const pickleReleases = [
  {
    version: "1.0.0",
    label: "정식 출시 🥒",
    notes: [
      "스크린샷을 찍으면 자동으로 문서 속 ‘피클병’ 폴더에 차곡차곡 저장돼요.",
      "메뉴바 아이콘에서 최근 캡처를 미리보기로 확인하고, 드래그 한 번으로 어디든 붙여넣기.",
      "잃어버린 캡처 찾으려고 폴더를 뒤질 필요가 없어요.",
      "가격은 0원, Intel·Apple Silicon 모든 Mac 지원.",
      "Apple 인증 완료로 설치 경고 없이 실행, 새 버전은 알아서 업데이트.",
    ],
  },
];
---
<BaseLayout site="intro" bodyClass="intro-body" title="Info">
  <section class="section container info">
    <header class="info__head">
      <h1>Info · 정보</h1>
      <p>두 앱의 버전 기록과 만드는 사람들을 소개합니다.</p>
    </header>

    <!-- ===== 릴리스노트 (피자클립 · 피클) ===== -->
    <div class="info__grid">
      <section class="rel">
        <h2 class="rel__brand">🍕 PIZZA CLIP <span>릴리스노트</span></h2>
        <ul class="releases releases--pizza">
          {releases.map((r) => (
            <li class="release">
              <div class="release__head">
                <span class="release__ver release__ver--pizza">v{r.version}</span>
                <span class="release__label">{r.label}</span>
              </div>
              <ul class="release__notes">
                {r.notes.map((n) => (<li>{n}</li>))}
              </ul>
            </li>
          ))}
        </ul>
      </section>

      <section class="rel">
        <h2 class="rel__brand">🥒 PICKle <span>릴리스노트</span></h2>
        <ul class="releases releases--pickle">
          {pickleReleases.map((r) => (
            <li class="release">
              <div class="release__head">
                <span class="release__ver release__ver--pickle">v{r.version}</span>
                <span class="release__label">{r.label}</span>
              </div>
              <ul class="release__notes">
                {r.notes.map((n) => (<li>{n}</li>))}
              </ul>
            </li>
          ))}
        </ul>
        <a class="rel__more" href="/pickle">
          <span class="rel__more-emoji" aria-hidden="true">🥒</span>
          <span><b>피클은 이제 막 1.0으로 출발했어요.</b><br />새 소식이 쌓이면 여기에 담을게요 — 피클 둘러보기 →</span>
        </a>
      </section>
    </div>

    <p class="info__more">
      자세한 변경 내역은 GitHub에서 —
      <a href={GITHUB_URL} target="_blank" rel="noopener">피자클립</a> ·
      <a href={PICKLE_GITHUB_URL} target="_blank" rel="noopener">피클</a>
    </p>

    <!-- ===== Team jAm 소개 ===== -->
    <div class="team-wrap">
      <section class="teamcard">
        <h2 class="teamcard__title">Team jAm</h2>
        <p class="teamcard__tagline">"모든 것은 장난스러운 상상에서 시작된다."</p>

        <p class="teamcard__body">
          <span class="brand">PIZZA&nbsp;CLIP</span> 과 <span class="brand">PICKle</span> 을 만든
          '<strong>Team&nbsp;jAm</strong>'은 jae_keun과 min_gyeol, 두 사람이 가벼운 상상을
          현실로 옮기며 시작한 작은 프로젝트 팀입니다.
        </p>
        <p class="teamcard__body">
          우리가 필요해서 만들었고, 만드는 과정 자체가 즐거워서 오늘도 기분 좋은 상상을 더해가며 계속 만들고 있습니다.
        </p>

        <div class="teamcard__sign">
          <span class="teamcard__en">"It all starts with a playful imagination."</span>
          <img class="teamcard__logo" src="/img/jam-logo.png" width="60" height="60"
               alt="Team jAm 로고" loading="lazy" />
        </div>
      </section>
    </div>

    <!-- ===== 더 둘러보기 (푸터 대용 빠른 링크) ===== -->
    <nav class="info__links" aria-label="앱 둘러보기">
      <a href={PIZZA_HOME}>피자클립 보러가기 →</a>
      <a href="/pickle">피클 보러가기 →</a>
    </nav>
  </section>
</BaseLayout>

<style>
  /* 슬레이트 배경 위 — 페이지 제목은 크림 */
  .info__head h1 { color: var(--intro-cream); }
  .info__head p { color: var(--intro-cream); }

  /* 두 제품 릴리스노트 2열(좁으면 1열) */
  .info__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: start;
  }
  .rel__brand {
    font-family: var(--font-en);
    color: var(--intro-cream);
    font-size: clamp(1.3rem, 3.4vw, 1.7rem);
    letter-spacing: 0.02em;
    margin-bottom: 1.1rem;
  }
  .rel__brand span {
    font-family: var(--font-sans);
    font-size: 0.7em;
    font-weight: 600;
    opacity: 0.85;
    margin-left: 0.4rem;
  }

  /* 릴리스 카드 — 슬레이트 위 크림 카드 + 단단한 오프셋 그림자 */
  .releases { display: grid; gap: 1rem; }
  .release {
    background: var(--color-bg);
    border: 2px solid var(--border-ink);
    border-radius: var(--radius-card);
    box-shadow: 6px 6px 0 0 rgba(16, 33, 56, 0.28);
    padding: 1.2rem 1.4rem;
  }
  .release__head { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  .release__ver { font-family: var(--font-en); font-weight: 700; font-size: 1.15rem; }
  .release__ver--pizza  { color: var(--color-point); }
  .release__ver--pickle { color: var(--pk-olive-ink); }
  .release__label { font-weight: 700; color: var(--color-ink); }
  .release__notes { margin-top: 0.7rem; display: grid; gap: 0.4rem; }
  .release__notes li { position: relative; padding-left: 1.4rem; color: var(--color-text); }
  .releases--pizza  .release__notes li::before { content: "🍕"; position: absolute; left: 0; font-size: 0.8em; }
  .releases--pickle .release__notes li::before { content: "🥒"; position: absolute; left: 0; font-size: 0.8em; }

  /* 피클 컬럼 균형용 안내 카드(피자 8개 vs 피클 1개 빈자리 보완) */
  .rel__more {
    display: flex; gap: 0.8rem; align-items: flex-start;
    margin-top: 1rem; padding: 1.1rem 1.3rem;
    background: var(--color-bg);
    border: 2px dashed var(--pk-olive-ink);
    border-radius: var(--radius-card);
    color: var(--color-ink); line-height: 1.55;
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }
  .rel__more:hover { transform: translateY(-2px); box-shadow: 6px 6px 0 0 rgba(16, 33, 56, 0.22); }
  .rel__more-emoji { font-size: 1.5rem; line-height: 1.2; }
  .rel__more b { color: var(--pk-olive-ink); }

  .info__more { margin-top: 1.5rem; font-size: var(--fs-small); color: var(--intro-cream); }
  .info__more a { text-decoration: underline; }
  .info__more a:hover { opacity: 0.8; }

  /* ===== Team jAm 카드 (슬레이트 위 흰 카드) ===== */
  .team-wrap { margin-top: var(--section-gap); }
  .teamcard {
    background: var(--color-surface);
    border: 3px solid #333;
    border-radius: 28px;
    box-shadow: 8px 8px 0 0 rgba(16, 33, 56, 0.28);
    padding: clamp(1.75rem, 4vw, 3rem);
    color: var(--color-ink);
  }
  .teamcard__title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--color-ink);
  }
  .teamcard__tagline { margin-top: 0.5rem; font-style: italic; color: #767676; font-size: var(--fs-small); }
  .teamcard__body {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: 1.12rem;
    line-height: 1.9;
    color: var(--color-ink);
  }
  .teamcard__body .brand { font-family: var(--font-en); font-weight: 700; letter-spacing: 0.02em; }
  .teamcard__body strong { font-family: var(--font-sans); font-weight: 700; }
  .teamcard__sign {
    margin-top: 2.25rem;
    display: flex; align-items: center; justify-content: flex-end;
    gap: 1rem; flex-wrap: wrap;
  }
  .teamcard__en { font-weight: 700; font-size: var(--fs-small); color: var(--color-ink); }
  .teamcard__logo { width: 60px; height: 60px; border-radius: 50%; flex: 0 0 auto; }

  /* 더 둘러보기 빠른 링크 */
  .info__links {
    margin-top: var(--section-gap);
    display: flex; gap: 1.25rem 2rem; flex-wrap: wrap; justify-content: center;
  }
  .info__links a {
    font-family: var(--font-en); font-weight: 700; letter-spacing: 0.02em;
    color: var(--intro-cream);
    border: 2px solid var(--intro-cream);
    border-radius: var(--radius-pill);
    padding: 0.55em 1.4em;
    transition: background 0.14s ease, color 0.14s ease, transform 0.14s ease;
  }
  .info__links a:hover { background: var(--intro-cream); color: var(--intro-dark); transform: translateY(-2px); }

  @media (max-width: 760px) {
    .info__grid { grid-template-columns: 1fr; }
  }
</style>
