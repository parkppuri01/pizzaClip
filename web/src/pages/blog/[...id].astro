---
/** 블로그 글 상세 — 본문 폰트 = 리디바탕(serif) */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post); // ⚠️ post.render() 아님 (Content Layer)

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="section container post">
    <header class="post__head">
      <a class="post__back" href="/blog">← 블로그 목록</a>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
    </header>
    <div class="post__body prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post { max-width: 720px; }
  .post__back { font-family: var(--font-en); color: var(--color-point); font-size: var(--fs-small); }
  .post__head { margin-bottom: 2rem; }
  .post__head h1 { margin-top: 0.75rem; }
  .post__head time { font-family: var(--font-en); color: var(--color-point); }

  /* 본문 = 리디바탕 (읽는 글에 어울리는 serif) */
  .prose {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    line-height: 1.9;
    color: var(--color-ink);
  }
  .prose :global(h2) { margin-top: 2rem; margin-bottom: 0.5rem; }
  .prose :global(h3) { margin-top: 1.5rem; margin-bottom: 0.4rem; }
  .prose :global(p)  { margin-bottom: 1.1rem; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.1rem 1.4rem; }
  .prose :global(li) { list-style: disc; margin-bottom: 0.4rem; }
  .prose :global(a)  { color: var(--color-point); text-decoration: underline; }
  .prose :global(code) {
    background: rgba(16,33,56,0.08); padding: 0.1em 0.4em; border-radius: 5px;
    font-size: 0.9em;
  }
</style>
