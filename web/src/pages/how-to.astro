---
/** HOW TO — 설치 & 사용법 가이드 (앱 실제 동작 기준) */
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";

// 설치·설정 단계 (각 단계 실제 화면 사진 포함)
const steps = [
  {
    n: "1",
    title: "Applications 폴더로 드래그",
    body: "다운로드한 <code>.dmg</code>를 열고 pizzaClip 아이콘을 <strong>응용 프로그램(Applications)</strong> 폴더로 끌어다 놓으세요.",
    img: "/img/howto-step-1.jpg",
    alt: "DMG 창에서 pizzaClip 앱을 Applications 폴더로 드래그하는 화면",
  },
  {
    n: "2",
    title: "처음 한 번, ‘열기’ 클릭",
    body: "설치 후 처음 실행하면 확인 창이 떠요. 개발자 서명 + 애플 공증이 된 앱이라 안전합니다. <strong>열기</strong>를 누르면 끝.",
    img: "/img/howto-step-2.jpg",
    alt: "‘pizzaClip.app을 열겠습니까?’ 확인 대화상자에서 열기 버튼",
  },
  {
    n: "3",
    title: "손쉬운 사용(Accessibility) 권한 켜기",
    body: "붙여넣기(⌘V)를 대신 눌러주려면 권한이 필요해요. <strong>시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용</strong>에서 pizzaClip 스위치를 켜주세요.",
    img: "/img/howto-step-3.jpg",
    alt: "시스템 설정 손쉬운 사용 목록에서 pizzaClip 스위치를 켜는 화면",
  },
];

// 실제 동작 데모 (public/img/*.gif)
const demos = [
  {
    src: "/img/howto-demo-1.gif",
    ratio: "1 / 1",
    title: "메뉴바 피자가 차오릅니다",
    body: "복사한 게 쌓일수록 메뉴바 아이콘이 한 조각씩 늘어나요. 지금 몇 개나 담겼는지 한눈에 보여요.",
  },
  {
    src: "/img/howto-demo-2.gif",
    ratio: "1 / 1",
    title: "복사하면 자동으로 담겨요",
    body: "따로 저장 버튼이 없어요. 평소처럼 ⌘C 하면 텍스트·이미지·파일이 알아서 히스토리에 쌓입니다.",
  },
];

const shortcuts = [
  { keys: "⌘⇧V", desc: "클립보드 히스토리 팝업 열기" },
  { keys: "⌘⌥⌃1 ~ 9", desc: "해당 번호 항목을 바로 붙여넣기" },
  { keys: "↑ ↓ / 1~9", desc: "팝업 안에서 항목 이동·선택" },
  { keys: "↵", desc: "선택한 항목 붙여넣기" },
  { keys: "0", desc: "9 → 1 전체 순차 붙여넣기" },
  { keys: "⌫", desc: "항목 삭제 · ⌘P 고정(핀)" },
  { keys: "오른쪽 ⌘", desc: "한국어 ↔ 영문 입력 전환 (옵션 켰을 때)" },
];

// 자주 묻는 질문 — 본문 표시 + AEO용 FAQPage 구조화 데이터로도 사용
const faqs = [
  {
    q: "유료인가요?",
    a: "아니요, 완전 무료입니다. 광고도 결제도 없어요.",
  },
  {
    q: "어떤 Mac에서 쓸 수 있나요?",
    a: "macOS 13(Ventura) 이상이면 Intel·Apple Silicon 모두 동작합니다. 유니버설 바이너리예요.",
  },
  {
    q: "왜 손쉬운 사용 권한이 필요한가요?",
    a: "선택한 항목을 대신 붙여넣기(⌘V) 해주려면 키 입력 권한이 필요합니다. 권한을 안 줘도 클립보드에 담기는 것까지는 동작해요.",
  },
  {
    q: "복사한 내용이 어디로 전송되나요?",
    a: "전송되지 않습니다. 모든 기록은 내 Mac 안에만 저장되고 외부 서버로 나가지 않아요.",
  },
  {
    q: "업데이트는 어떻게 되나요?",
    a: "앱이 자동으로 새 버전을 확인하고 알려줍니다. 직접 다시 받을 필요 없어요.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<BaseLayout title="How to" description="pizzaClip 설치와 사용법 — 단축키와 권한 설정까지 한 번에." image="/img/og-howto.jpg">
  <section class="section container">
    <header class="page-head">
      <h1>How to · 사용법</h1>
      <p>설치부터 단축키까지, 1분이면 충분합니다.</p>
    </header>

    <!-- 히어로 비주얼 (배경 투명 PNG — 프레임 없이 띄움) -->
    <figure class="hero-shot">
      <img src="/img/howto-hero.png" alt="맥북 화면에 ‘Dive into PIZZA CLIP’ 이 떠 있는 목업" width="1600" height="666" loading="eager" />
    </figure>

    <!-- 설치 단계 -->
    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <span class="step__n" aria-hidden="true">{s.n}</span>
          <div class="step__body">
            <h2>{s.title}</h2>
            <p set:html={s.body} />
            {s.img && (
              <figure class="step__shot framed">
                <img src={s.img} alt={s.alt} loading="lazy" />
              </figure>
            )}
          </div>
        </li>
      ))}
    </ol>

    <!-- 눈으로 보는 동작 데모 -->
    <h2 class="block-title">눈으로 보는 pizzaClip</h2>
    <div class="demos">
      {demos.map((d) => (
        <figure class="demo">
          <div class="demo__frame framed" style={`aspect-ratio:${d.ratio}`}>
            <img src={d.src} alt={d.title} loading="lazy" />
          </div>
          <figcaption>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- 단축키 표 -->
    <Card variant="menu" class="shortcuts">
      <h2>단축키 한눈에</h2>
      <br />
      <dl class="kbd-list">
        {shortcuts.map((s) => (
          <div class="kbd-row">
            <dt><kbd>{s.keys}</kbd></dt>
            <dd>{s.desc}</dd>
          </div>
        ))}
      </dl>
    </Card>

    <!-- 숨은 기능 한 스푼 -->
    <div class="tips">
      <h2 class="block-title">이런 것도 돼요</h2>
      <ul class="tip-list">
        <li><strong>전체 순차 붙여넣기</strong> — 팝업에서 <kbd>0</kbd>을 누르면 9번부터 1번까지 한 번에 차례로 붙습니다. 여러 항목을 양식에 채울 때 편해요.</li>
        <li><strong>한/영 전환</strong> — 설정에서 켜면 오른쪽 ⌘ 키만 톡 눌러 한국어 ↔ 영문 입력을 전환할 수 있어요.</li>
        <li><strong>🍕 이스터에그</strong> — 클립보드에 정확히 “pizza” 또는 “피자”를 복사하면… 직접 확인해 보세요.</li>
      </ul>
    </div>

    <!-- FAQ -->
    <h2 class="block-title">자주 묻는 질문</h2>
    <dl class="faq">
      {faqs.map((f) => (
        <div class="faq__item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- AEO/GEO: FAQ 구조화 데이터 -->
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>

<style>
  /* 공통 프레임: 사이트 사진/카드와 동일한 차콜 테두리 + 단단한 오프셋 그림자 */
  .framed {
    border: 2px solid var(--border-ink);
    box-shadow: 8px 8px 0 var(--border-ink);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #000;
  }

  .hero-shot {
    margin: 0 0 var(--section-gap);
    max-width: 900px;
    margin-inline: auto;
  }
  .hero-shot img { display: block; width: 100%; height: auto; }

  .steps { display: grid; gap: 3rem; margin-bottom: var(--section-gap); }
  /* 번호 배지 → 제목 → 설명 → 사진 을 세로로 가운데 정렬 */
  .step  { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.6rem; }
  .step__n {
    flex: 0 0 auto;
    width: 2.5rem; height: 2.5rem;
    display: grid; place-items: center;
    background: var(--color-point); color: var(--color-menu);
    font-family: var(--font-en); font-weight: 700; font-size: 1.2rem;
    border-radius: 999px;
  }
  .step__body { min-width: 0; }
  .step h2 { font-size: var(--fs-h3); }
  .step p  { margin-top: 0.4rem; max-width: 560px; margin-inline: auto; }
  .step :global(code) {
    background: rgba(16,33,56,0.08); padding: 0.1em 0.4em; border-radius: 5px;
    font-size: 0.9em;
  }
  .step__shot {
    margin: 1rem auto 0;     /* 가운데 정렬 */
    max-width: 416px;        /* 기존 520px 의 80% — 더 작고 선명하게 */
  }
  .step__shot img { display: block; width: 100%; height: auto; }

  .block-title {
    font-size: var(--fs-h2, 1.6rem);
    text-align: center;
    margin: var(--section-gap) 0 1.5rem;
  }

  /* 데모 (GIF) */
  .demos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: var(--section-gap);
    align-items: start;
    /* 컬럼은 넓게 두어 캡션 줄바꿈 방지 + 가운데 정렬 */
    max-width: 58%;
    margin-inline: auto;
  }
  /* GIF 는 작게(≈210px) 고정, 캡션은 컬럼 폭(넓게) 사용 → 문장 안 깨짐 */
  .demo { margin: 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .demo__frame { width: 100%; max-width: 210px; }
  .demo__frame img {
    display: block; width: 100%; height: 100%; object-fit: cover;
  }
  .demo figcaption { margin-top: 1rem; }
  .demo figcaption h3 { font-size: var(--fs-h3); }
  .demo figcaption p  { margin-top: 0.35rem; color: var(--color-ink); }

  .shortcuts h2 { margin-bottom: 1.25rem; }
  .kbd-list { display: grid; gap: 0.6rem; }
  .kbd-row  { display: grid; grid-template-columns: minmax(120px, 180px) 1fr; gap: 1rem; align-items: baseline; }
  kbd {
    font-family: var(--font-en);
    background: var(--color-ink); color: var(--color-bg);
    padding: 0.25em 0.6em; border-radius: 6px; font-size: 0.95rem;
    white-space: nowrap;
  }
  .kbd-row dd { color: var(--color-ink); }

  /* 팁 */
  .tips { margin-bottom: var(--section-gap); }
  .tip-list { display: grid; gap: 0.9rem; max-width: 640px; margin-inline: auto; }
  .tip-list li { line-height: 1.6; }
  .tip-list kbd { font-size: 0.85rem; padding: 0.1em 0.45em; }

  /* FAQ */
  .faq { max-width: 700px; margin-inline: auto; display: grid; gap: 0.75rem; }
  .faq__item {
    border: 2px solid var(--border-ink);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    background: #fff;
  }
  .faq__item dt { font-weight: 700; color: var(--color-title, var(--color-ink)); }
  .faq__item dd { margin: 0.4rem 0 0; color: var(--color-ink); line-height: 1.6; }

  @media (max-width: 640px) {
    .demos { grid-template-columns: 1fr; gap: 2.5rem; max-width: 100%; }
    .kbd-row { grid-template-columns: 1fr; gap: 0.25rem; }
    .step__shot { max-width: 100%; }
  }
</style>
