---
/** 메인 랜딩 — web/guide/pizza web.png 목업 흐름 구현 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import SliceDivider from "../components/SliceDivider.astro";
import { DOWNLOAD_URL } from "../consts.ts";

const features = [
  { icon: "🍕", title: "⌘C의 무한 보관소", desc: "글자부터 이미지, 파일까지 복사하는 즉시 알아서 담아둡니다. 새로 복사했다고 이전 기록이 사라지던 답답함은 끝!" },
  { icon: "⚡", title: "트랙패드 없는 키보드 워리어용", desc: "⌘ + ⇧ + V로 클립보드를 열고, 단축키(0~9)로 원하는 조각을 바로 골라 쓰세요. 진짜 1초 컷!" },
  { icon: "🇰🇷", title: "Mac 유저 필수, 가려운 곳 긁기", desc: "잠자는 오른쪽 ⌘ 키 하나로 한/영 전환을 가볍게 해결하세요. 맥북 쓰면서 은근히 킹받던 입력 소스 전환 스트레스를 날려줍니다. (원치 않으면 언제든 켜고 끌 수 있는 옵션)" },
  { icon: "🔒", title: "철저한 로컬 보안", desc: "복사한 비밀번호나 개인정보가 밖으로 샐까 걱정되셨나요? 모든 히스토리는 외부 서버를 타지 않고 오직 내 맥 안에서만 보관됩니다." },
];

const downloadChecks = [
  "가격은 0원 — 조건 없이 받아서 쓰세요",
  "내 맥북에 찰떡 — 기종 상관없이 모든 Mac에서 부드럽게 작동",
  "안전해요 — 애플 인증 완료! 바이러스·보안 경고 걱정 없어요",
  "알아서 업데이트 — 수동으로 안 챙겨도 늘 최신 상태",
];
---
<BaseLayout>
  <!-- ===== 히어로 ===== -->
  <section class="section hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1>Mac 메뉴바에<br />배달된 피자 한판 🍕</h1>
        <p class="hero__lead">
          <strong>⌘C로 주문하고, 단축키 한 번으로 바로 배달받으세요.</strong><br />
          방금 복사한 뜨끈한 텍스트부터 아까 아껴둔 이미지까지,<br />
          식기 전에 메뉴바에서 쏙쏙 꺼내 씁니다.
        </p>
        <div class="hero__cta">
          <Button href={DOWNLOAD_URL} variant="primary">Download</Button>
          <Button href="/how-to" variant="secondary">How&nbsp;to</Button>
        </div>
      </div>
      <div class="hero__art">
        <img src="/img/pizza-store.jpg" width="828" height="1100"
             alt="피자클립 — 메뉴바에서 꺼내 쓰는 피자 가게 일러스트" />
      </div>
    </div>
  </section>

  <SliceDivider count={1} />

  <!-- ===== 후킹 카드 ===== -->
  <section class="section container">
    <Card variant="menu" class="hook">
      <h2>언제까지 ⌘C, ⌘V 무한 반복하실 건가요?</h2>
      <p class="hook__sub">방금 복사한 거 날려 먹고 ‘아…’ 한 적 있다면 집중!</p>
      <p>방금 복사한 것 때문에 <em>이전 기록이 사라져</em> 다시 원본을 찾아 헤맨 경험, 다들 있으시죠?
         피자클립은 당신의 복사 히스토리를 한 판 가득 저장해 둡니다.
         이제 헤매지 말고 필요할 때마다 한 조각씩 가볍게 꺼내 쓰세요.</p>
    </Card>
  </section>

  <SliceDivider count={2} />

  <!-- ===== 광고판 이미지 ===== -->
  <section class="section container">
    <figure class="billboard">
      <img src="/img/billboard.jpg" width="1400" height="933"
           alt="피자클립 레트로 광고판" loading="lazy" />
      <figcaption>STILL HAVEN'T TRIED THE PIZZA CLIP?</figcaption>
    </figure>
  </section>

  <SliceDivider count={3} />

  <!-- ===== 기능 소개 ===== -->
  <section class="section container">
    <Card variant="menu">
      <h2 class="features__title">피자클립이 하는 일</h2>
      <ul class="features">
        {features.map((f) => (
          <li class="feature">
            <span class="feature__icon" aria-hidden="true">{f.icon}</span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </Card>
  </section>

  <SliceDivider count={4} />

  <!-- ===== 매장 광고 사진 (Copy it while it's hot) ===== -->
  <section class="section container">
    <figure class="storefront">
      <img src="/img/storefront.jpg" width="1400" height="933"
           alt="피자클립 매장 광고 — “Copy it while it's hot” 포스터" loading="lazy" />
    </figure>
  </section>

  <!-- ===== 다운로드 카드 ===== -->
  <section class="section container" id="download">
    <Card variant="white" class="download">
      <div class="download__inner">
        <h2>어메이징, 피자클립 🍕</h2>
        <ul class="download__checks">
          {downloadChecks.map((c) => (<li>{c}</li>))}
        </ul>
        <Button href={DOWNLOAD_URL} variant="primary" class="download__btn">Download</Button>
        <p class="download__note">
          macOS 13 이상 · 모든 Mac 지원 · 무료
        </p>
      </div>
    </Card>
  </section>
</BaseLayout>

<style>
  /* 히어로 */
  .hero__inner {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 6vw, 4rem);
    flex-wrap: wrap;
  }
  .hero__copy { flex: 1 1 320px; }
  .hero__lead { font-size: 1.15rem; margin-top: 1.25rem; color: var(--color-text); }
  .hero__cta  { display: flex; gap: 0.75rem; margin-top: 2rem; flex-wrap: wrap; }
  .hero__art  { flex: 0 0 auto; margin-inline: auto; max-width: min(300px, 72vw); }
  .hero__art img {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 14px 40px rgba(16, 33, 56, 0.18);
  }

  /* 후킹 카드 */
  .hook h2 { font-size: var(--fs-h2); }
  .hook p.hook__sub { margin-top: 0.75rem; font-weight: 700; color: var(--color-point); font-size: 1.05rem; }
  .hook p  { margin-top: 1rem; font-size: 1.1rem; }
  .hook em { font-style: normal; color: var(--color-point); font-weight: 700; }

  /* 광고판 */
  .billboard img { border-radius: var(--radius-card); width: 100%; }
  .billboard figcaption {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-en);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-point);
  }

  /* 매장 광고 사진 — 가운데 정렬, 라운드 */
  .storefront { text-align: center; }
  .storefront img {
    border-radius: var(--radius-card);
    width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
  }

  /* 기능 */
  .features__title { margin-bottom: 1.5rem; }
  .features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .feature  { display: flex; gap: 0.9rem; align-items: flex-start; }
  .feature__icon { font-size: 1.8rem; line-height: 1.2; }
  .feature h3 { font-size: 1.15rem; }
  .feature p  { margin-top: 0.3rem; color: var(--color-ink); opacity: 0.85; }

  /* 다운로드 카드 — 슬롯 래퍼에 정렬을 줘야 Card 컴포넌트 경계를 넘어서도 적용됨 */
  .download__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .download__checks {
    display: grid;
    gap: 0.6rem;
    text-align: left;
    margin: 1.5rem 0;
  }
  .download__checks li { position: relative; padding-left: 1.8rem; }
  .download__checks li::before {
    content: "✓";
    position: absolute; left: 0;
    color: var(--color-point); font-weight: 700;
  }
  .download__btn  { font-size: 1.1rem; padding: 0.9em 2.4em; }
  .download__note { margin-top: 1rem; font-size: var(--fs-small); opacity: 0.7; }

  @media (max-width: 640px) {
    .features { grid-template-columns: 1fr; }
    .hero__copy { text-align: center; }
    .hero__cta  { justify-content: center; }
  }
</style>
