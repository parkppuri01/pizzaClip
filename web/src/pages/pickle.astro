---
/**
 * 피클 홈(/pickle) — 신규 단일 페이지.
 * 가이드: web/guide/renewal/pickle.png
 * 띠: 크림(히어로) → 올리브(카드) → 블루(카드) → 샌드(카드) → 그레이(CTA카드).
 * 카드는 직각 사각형. 스티커는 카드 사이 경계에 좌·중·우로 얹힘(위로 삐짐).
 * 1.0.0 정식 출시 — 다운로드는 PICKLE_DOWNLOAD_URL(로컬 호스팅 DMG) 직링크 + 인스타 소식받기.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { PICKLE_DOWNLOAD_URL } from "../consts.ts";

// 캡처 단축키 — 피클 전용 글로벌 단축키(KeyboardShortcuts, Settings에서 변경 가능).
// 출처: github.com/parkppuri01/pickle → PicKle/Shortcuts/Shortcuts.swift 기본값.
const pickleShortcuts = [
  { keys: "⇧⌥S", desc: "영역 선택 → ‘피클병’ 폴더에 바로 저장" },
  { keys: "⇧⌥D", desc: "영역 선택 → 편집창에서 펜·블러·자르기" },
  { keys: "⇧⌥A", desc: "영역 선택 → 저장 없이 클립보드로 복사" },
  { keys: "⇧⌥F", desc: "보관함(최근 캡처) 열기 · 닫기" },
  { keys: "편집창 ⌘Z · ↵ · esc", desc: "되돌리기 · 자르기 적용 · 취소" },
];

// 피클이 하는 일 — 헤드라인 + 본문 3개(피자클립 '하는 일' 섹션과 동일 톤).
const pickleFeatures = [
  {
    title: "당신의 바탕화면도 스크린샷으로 테트리스 중인가요? (저만 그런 거 아니죠? 🫣)",
    desc: "찍을 땐 좋았지만 돌아서면 미아가 되는 스크린샷들. 이제 여기저기 헤매지 말고 [문서] 폴더 속 ‘피클병’ 하나만 기억하세요. 스크린샷을 찍는 순간, 피클병이 알아서 쏙쏙 받아 담아둡니다. 바탕화면은 미니멀하게, 스크린샷 찾기는 심플하게.",
  },
  {
    title: "스크린샷 한 장 편집하자고 포토샵까지 소환하긴 솔직히 귀찮잖아요. 🤫",
    desc: "계좌번호 가리기, 서명 넣기, 필요한 부분만 싹둑 자르기… 이 모든 걸 프로그램 하나로 손쉽게 해결할 수 있다면? 번거로운 이리저리 이동 없이, 스크린샷 찍고 피클 안에서 한 번에 슥- 이제 보안도, 편집도 피클 하나로 가볍게 ‘싹 가능’입니다.",
  },
  {
    title: "메뉴바 위에 동동 떠 있는 가장 귀여운 보관함",
    desc: "아까 찍은 스크린샷이 필요할 땐, 메뉴바에 상주하는 귀여운 피클병을 톡- 클릭하세요. 무엇이 들어있는지 한눈에 확인하고, 필요한 곳으로 드래그 앤 드롭하면 끝! 작업의 흐름을 깨지 않는 가장 우아하고 직관적인 스크린샷 보관함, 피클병입니다.",
  },
];
---
<BaseLayout site="pickle">
  <!-- ===== 히어로 (크림) ===== -->
  <section class="hero band">
    <div class="container hero__inner">
      <div class="hero__copy" data-reveal>
        <h1>“캡처는 했는데 어디 갔지?” 병<br />이거 완벽하게 고쳐드립니다.</h1>
        <p class="hero__lead">
          “어라, 분명히 찍어뒀는데…” 스크린샷 실종사건 이제 그만.
          중요한 스크린샷을 피클처럼 새콤하게 절여두세요.
          필요할 때마다 쏙쏙, 가장 신선한 상태로 찾아 드립니다.
        </p>
        <div class="hero__cta">
          <a class="pill pill--go" href={PICKLE_DOWNLOAD_URL}>다운로드</a>
        </div>
      </div>
      <figure class="hero__art" data-reveal>
        <img src="/img/pickle/hero-char.png" width="800" height="698"
             alt="피클 캐릭터 — 맥북을 들고 달려오는 피클" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <!-- ===== 자동 저장 (올리브) ===== -->
  <section class="band band--olive" id="pk-start">
    <div class="bandwrap">
      <div class="panel" data-reveal>
        <h2>저만 스크린샷이 배경화면을 지배하고 있는거 아니죠?</h2>
        <h3 class="panel__sub">피클병에 차곡차곡 담아두세요</h3>
        <p>
          스크린샷을 찍으면 자동으로 문서 속 “피클병” 폴더에 저장됩니다.
          잃어버린 캡처를 찾으려고 폴더를 뒤질 필요는 없습니다.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 빠른 접근 (블루) — 올리브/블루 경계에 스티커 3종 ===== -->
  <section class="band band--blue">
    <div class="bandwrap">
      <img class="sticker s-easy" src="/img/pickle/sticker-easy.png" alt="" aria-hidden="true" loading="lazy" />
      <img class="sticker s-snap hide-sm" src="/img/pickle/snap-oval.png" alt="" aria-hidden="true" loading="lazy" />
      <img class="sticker s-jar hide-sm" src="/img/pickle/jar.png" alt="" aria-hidden="true" loading="lazy" />
      <div class="panel" data-reveal>
        <h2>필요한 캡처를, 필요한 순간에</h2>
        <h3 class="panel__sub">메뉴바에서 바로 꺼내기</h3>
        <p>
          최근에 찍은 캡처는 피클 메뉴바 아이콘에서 미리보기로 바로 확인하고,
          드래그 한 번으로 메일·메신저·문서 어디든 붙여넣으세요.
          폴더를 열고 파일을 뒤질 필요가 없습니다.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 쓰는 법 (샌드) — 블루/샌드 경계에 스티커 2종 ===== -->
  <section class="band band--sand">
    <div class="bandwrap">
      <img class="sticker s-fresh" src="/img/pickle/card-fresh.png" alt="" aria-hidden="true" loading="lazy" />
      <img class="sticker s-sign hide-sm" src="/img/pickle/sign-char.png" alt="" aria-hidden="true" loading="lazy" />
      <div class="panel" data-reveal>
        <h2>단축키 한눈에 🥒</h2>
        <p class="panel__sub">찍는 즉시 저장·편집·복사까지. 전부 Settings에서 바꿀 수 있어요.</p>
        <dl class="kbd-list">
          {pickleShortcuts.map((s) => (
            <div class="kbd-row">
              <dt><kbd>{s.keys}</kbd></dt>
              <dd>{s.desc}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ===== 피클이 하는 일 (올리브) ===== -->
  <section class="band band--olive">
    <div class="bandwrap">
      <div class="panel features" data-reveal>
        <h2 class="features__title">피클이 하는 일</h2>
        <ol class="feature-list">
          {pickleFeatures.map((f, i) => (
            <li class="feature">
              <span class="feature__num" aria-hidden="true">{i + 1}</span>
              <div class="feature__body">
                <h3>{f.title}</h3>
                <p>{f.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== 다운로드 CTA (그레이) ===== -->
  <section class="band band--gray" id="download">
    <div class="bandwrap">
      <div class="panel cta" data-reveal>
        <div class="cta__inner">
          <h2>피클, 지금 바로 받아보세요</h2>
          <p class="cta__lead">
            가격은 0원, 모든 Mac 지원. 스크린샷을 찍는 즉시 ‘피클병’에 차곡차곡 담아드릴게요.
            잃어버린 캡처 찾느라 폴더 뒤지는 일은 이제 끝.
          </p>
          <div class="cta__btns">
            <a class="pill pill--go pill--lg" href={PICKLE_DOWNLOAD_URL}>다운로드</a>
          </div>
          <p class="cta__note">macOS 13 이상 · 모든 Mac 지원 · 무료</p>
        </div>
      </div>
      <img class="sticker s-person" src="/img/pickle/sticker-person.png" alt="" aria-hidden="true" loading="lazy" />
    </div>
  </section>
</BaseLayout>

<style>
  .band { overflow-x: clip; padding-block: clamp(5rem, 9vw, 8rem); position: relative; }
  .band--olive { background: var(--pk-olive); }
  .band--blue  { background: var(--pk-blue); }
  .band--sand  { background: var(--pk-sand); }
  .band--gray  { background: var(--pk-gray); }

  /* 자동저장(올리브)↔빠른접근(블루) 박스 사이를 넓혀 스티커가 놀 공간 확보(가이드 기준).
     올리브쪽 패딩을 크게 줘 경계를 내려 스티커가 올리브 배경 위에 놓이게. */
  #pk-start { padding-bottom: clamp(10.5rem, 16vw, 13rem); }
  /* --pk-gap-pt 를 블루 패딩과 스티커 위치 calc 에 함께 써서, 스티커가 항상 경계선 기준 일정 높이에 놓이게(폭 무관 안정). */
  .band--blue { --pk-gap-pt: clamp(5rem, 9vw, 7.5rem); padding-top: var(--pk-gap-pt); }

  /* 위치 기준 = 카드 폭의 래퍼 */
  .bandwrap { position: relative; max-width: 880px; margin-inline: auto; padding-inline: var(--gutter); }

  /* ── 콘텐츠 패널(피클: 직각 사각형 + 차콜 오프셋 그림자) ── */
  .bandwrap .panel { width: 100%; max-width: none; margin: 0; border-radius: 2px; }
  .panel h2 { font-size: var(--fs-h2); color: var(--color-ink); }
  .panel__sub { margin-top: 1rem; font-size: 1.15rem; color: var(--pk-olive-ink); font-weight: 700; }
  .panel p { margin-top: 0.8rem; font-size: 1.08rem; color: var(--color-text); }

  /* ── 피클이 하는 일: 번호 뱃지 + 헤드라인 + 본문, 세로 리스트 ── */
  .features__title { margin-bottom: 1.5rem; }
  .feature-list { display: grid; gap: 1.5rem; list-style: none; padding: 0; margin: 0; }
  .feature { display: flex; gap: 0.95rem; align-items: flex-start; }
  .feature__num {
    flex: 0 0 auto; width: 2rem; height: 2rem; border-radius: 50%;
    display: grid; place-items: center; margin-top: 0.15rem;
    background: var(--pk-olive-ink); color: var(--color-bg);
    font-family: var(--font-en); font-weight: 700; font-size: 1.05rem;
  }
  .feature__body h3 { font-size: 1.16rem; line-height: 1.35; color: var(--color-ink); }
  .feature__body p { margin-top: 0.4rem; color: var(--color-text); font-size: 1rem; line-height: 1.65; }

  /* ── 히어로 ── */
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem); }
  .hero__inner { display: flex; align-items: center; gap: clamp(2rem, 6vw, 4rem); flex-wrap: wrap; }
  .hero__copy { flex: 1 1 340px; }
  .hero h1 { font-size: clamp(1.6rem, 4.3vw, 2.6rem); color: var(--color-ink); line-height: 1.22; }
  .hero__lead { font-size: 1.1rem; margin-top: 1.25rem; color: var(--color-text); max-width: 46ch; }
  .hero__cta { display: flex; gap: 0.75rem; margin-top: 2rem; flex-wrap: wrap; }
  .hero__art { flex: 0 0 auto; margin-inline: auto; width: min(360px, 80vw); }
  .hero__art img { width: 100%; height: auto; }

  /* ── 단축키 표(how-to 단축키와 동일 톤) ── */
  .kbd-list { margin-top: 1.4rem; display: grid; gap: 0.6rem; }
  .kbd-row { display: grid; grid-template-columns: minmax(120px, 200px) 1fr; gap: 1rem; align-items: baseline; }
  .kbd-row dd { color: var(--color-ink); }
  kbd {
    font-family: var(--font-en);
    background: var(--color-ink); color: var(--color-bg);
    padding: 0.25em 0.6em; border-radius: 6px; font-size: 0.95rem;
    white-space: nowrap; display: inline-block;
  }

  /* ── 다운로드 CTA ── */
  .cta { text-align: center; }
  .cta__inner { display: flex; flex-direction: column; align-items: center; }
  .cta__lead { max-width: 48ch; }
  .cta__btns { display: flex; gap: 0.75rem; margin-top: 1.6rem; flex-wrap: wrap; justify-content: center; }
  .cta__note { margin-top: 1rem; font-size: var(--fs-small); opacity: 0.7; }

  /* ── 피클 알약 버튼 ── */
  .pill {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-en); font-weight: 700; letter-spacing: 0.02em;
    font-size: 1rem; padding: 0.6em 1.5em;
    border-radius: var(--radius-pill); border: 2px solid transparent;
    white-space: nowrap; appearance: none; -webkit-appearance: none;
    transition: transform 0.12s ease, background 0.12s ease, color 0.12s ease;
  }
  .pill--lg { font-size: 1.05rem; padding: 0.8em 2em; }
  /* 다운로드(채운 올리브) */
  .pill--go { background: var(--pk-olive-ink); color: var(--color-bg); border-color: var(--pk-olive-ink); }
  .pill--go:hover { background: var(--pk-green); border-color: var(--pk-green); transform: translateY(-1px); }

  /* ── 스티커: 카드 사이 경계에 얹힘(위로 삐짐), 카드 폭 기준 좌·중·우 ── */
  .sticker { position: absolute; pointer-events: none; user-select: none; z-index: 3;
             filter: drop-shadow(2px 4px 5px rgba(0,0,0,0.18)); width: var(--sw, 160px); }
  /* 올리브/블루 경계: Easy(좌) · SNAP TOOL(중) · 병(우) */
  .s-easy { --sw: clamp(150px, 19vw, 250px); left: 5%; top: calc(-1 * var(--pk-gap-pt) - 6.3rem); transform: rotate(-7deg); }
  .s-snap { --sw: clamp(200px, 17vw, 225px); left: 50%; top: calc(-1 * var(--pk-gap-pt) - 3.8rem); transform: translateX(-50%) rotate(2deg); }
  .s-jar  { --sw: clamp(78px, 10vw, 125px); right: 11%; top: calc(-1 * var(--pk-gap-pt) - 8.3rem); transform: rotate(-15deg); }
  /* 블루/샌드 경계: Screenshot 카드(좌) · 안내판 피클(우) */
  .s-fresh { --sw: clamp(250px, 22vw, 255px); left: 10%; top: -50%; transform: rotate(4deg); }
  .s-sign  { --sw: clamp(170px, 18vw, 200px); right: 10%; top: -60%; transform: rotate(2deg); }
  /* 그레이: "I'm a PICKle person" — 카드 우상단 모서리 */
  .s-person { --sw: clamp(115px, 16vw, 195px); right: -2%; top: -18%; transform: rotate(6deg); }

  @media (max-width: 760px) {
    .hero__copy { text-align: center; }
    .hero__lead { margin-inline: auto; }
    .hero__cta { justify-content: center; }
    .hide-sm { display: none !important; }
    /* 모바일은 s-easy 1개만 노출 → 올리브 간격 적당히 줄이고 가운데 배치 */
    #pk-start { padding-bottom: clamp(6rem, 15vw, 8.5rem); }
    .s-easy { --sw: 116px; left: 0; top: calc(-1 * var(--pk-gap-pt) - 2.5rem); }
    .s-fresh { --sw: 116px; left: 0; top: -23%; }
    .s-person { --sw: 92px; right: -1%; top: -15%; }
    .kbd-row { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
